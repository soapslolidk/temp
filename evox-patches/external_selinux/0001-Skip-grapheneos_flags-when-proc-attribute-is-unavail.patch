From 76e6d9d508a2268dd65fa751a5952d5363eaa4e6 Mon Sep 17 00:00:00 2001
From: Kyros70 <Kyros70@users.noreply.github.com>
Date: Wed, 7 Oct 2026 12:51:03 +0000
Subject: [PATCH] Skip grapheneos_flags when proc attribute is unavailable

Change-Id: If639004c0bbf0c6e5d4ed429da0b08254c89fda3
---
 libselinux/src/android/android_device.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/libselinux/src/android/android_device.c b/libselinux/src/android/android_device.c
index 9339e8a..68e00a7 100644
--- a/libselinux/src/android/android_device.c
+++ b/libselinux/src/android/android_device.c
@@ -122,7 +122,15 @@ int selinux_android_setcontext(uid_t uid,
 
 	if (strcmp(ctx_str, orig_ctx_str)) {
 		rc = selinux_android_setcon(ctx_str);
-		if (rc < 0)
+		if (rc < 0 && errno == ENOENT) {
+			/* Kernel does not support the grapheneos_flags proc
+			 * attribute (requires GrapheneOS kernel patches).
+			 * Silently skip -- the hardening features backed by
+			 * these flags simply won't be enforced. */
+			selinux_log(SELINUX_WARNING,
+				"%s: kernel lacks grapheneos_flags support, skipping\n",
+				__FUNCTION__);
+		} else if (rc < 0)
 			goto err;
 	}
 
-- 
2.34.1

