From e215a235cf00a59c89853b616e62f0942861a77a Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Wed, 15 May 2024 05:56:59 -0400
Subject: [PATCH 05/12] More bpf errors ignore -- there are some 4.14 without
 the bpf jit file

---
 bpf/loader/NetBpfLoad.cpp | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
index d6b0879..1527580 100644
--- a/bpf/loader/NetBpfLoad.cpp
+++ b/bpf/loader/NetBpfLoad.cpp
@@ -1722,8 +1722,7 @@ static int doLoad(char** argv, char * const envp[]) {
         // but we need 0 (enabled)
         // (this writeFile is known to fail on at least 4.19, but always defaults to 0 on
         // pre-5.13, on 5.13+ it depends on CONFIG_BPF_UNPRIV_DEFAULT_OFF)
-        if (!writeFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n") &&
-            isAtLeastKernelVersion(5, 13)) {
+        if (!writeFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n")) {
             failed = true;
         }
     }
-- 
2.34.1

