From 90aa10b221efef1eff084a5cf5e8f8377dedbc27 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 26 Sep 2026 21:33:52 +0100
Subject: [PATCH 39/85] wallpaper: enable per-screen default wallpaper
 properties

openRawDefaultWallpaper() hardcoded the system wallpaper property and
resource for both home and lock screens; the per-flag branch was left
commented out upstream (factory-default lock wallpapers are not yet
supported). enable it: FLAG_LOCK now reads ro.config.lock_wallpaper
with no drawable fallback, FLAG_SYSTEM keeps ro.config.wallpaper and
the framework default_wallpaper resource.

lets a rom ship distinct default home and lock wallpapers via
ro.config.wallpaper and ro.config.lock_wallpaper.
---
 core/java/android/app/WallpaperManager.java | 21 +++++++++------------
 1 file changed, 9 insertions(+), 12 deletions(-)

diff --git a/core/java/android/app/WallpaperManager.java b/core/java/android/app/WallpaperManager.java
index 822dda7a5..92c1c85dc 100644
--- a/core/java/android/app/WallpaperManager.java
+++ b/core/java/android/app/WallpaperManager.java
@@ -3459,14 +3459,9 @@ public class WallpaperManager {
      */
     public static InputStream openRawDefaultWallpaper(Context context,
             @SetWallpaperFlags int which) {
-        final String whichProp;
-        final int defaultResId;
-        /* Factory-default lock wallpapers are not yet supported.
-        whichProp = which == FLAG_LOCK ? PROP_LOCK_WALLPAPER : PROP_WALLPAPER;
-        defaultResId = which == FLAG_LOCK ? R.drawable.default_lock_wallpaper :  ....
-        */
-        whichProp = PROP_WALLPAPER;
-        defaultResId = R.drawable.default_wallpaper;
+        final String whichProp = which == FLAG_LOCK ? PROP_LOCK_WALLPAPER : PROP_WALLPAPER;
+        final int defaultResId =
+                which == FLAG_LOCK ? 0 : R.drawable.default_wallpaper;
         final String path = SystemProperties.get(whichProp);
         final InputStream wallpaperInputStream = getWallpaperInputStream(path);
         if (wallpaperInputStream != null) {
@@ -3477,10 +3472,12 @@ public class WallpaperManager {
         if (cmfWallpaperInputStream != null) {
             return cmfWallpaperInputStream;
         }
-        try {
-            return context.getResources().openRawResource(defaultResId);
-        } catch (NotFoundException e) {
-            // no default defined for this device; this is not a failure
+        if (defaultResId != 0) {
+            try {
+                return context.getResources().openRawResource(defaultResId);
+            } catch (NotFoundException e) {
+                // no default defined for this device; this is not a failure
+            }
         }
         return null;
     }
-- 
