From 7a66589fac9296e39426a0e617ff9f44e2125e69 Mon Sep 17 00:00:00 2001
From: patch <patch@local>
Date: Tue, 6 Oct 2026 01:38:15 +0000
Subject: [PATCH 82/85] Re-implement fnmatch-like behaviour for RRO java side

---
 .../content/pm/parsing/FrameworkParsingPackageUtils.java | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/core/java/android/content/pm/parsing/FrameworkParsingPackageUtils.java b/core/java/android/content/pm/parsing/FrameworkParsingPackageUtils.java
index ac2676236..5ab7f8064 100644
--- a/core/java/android/content/pm/parsing/FrameworkParsingPackageUtils.java
+++ b/core/java/android/content/pm/parsing/FrameworkParsingPackageUtils.java
@@ -233,7 +233,14 @@ public class FrameworkParsingPackageUtils {
                 continue;
             }
             // 3. Check if prop is equal to expected value.
-            if (!currValue.equals(propValues[i])) {
+            final String value = propValues[i];
+            if (value.startsWith("+")) {
+                final java.util.regex.Pattern regex = java.util.regex.Pattern.compile(value.substring(1, value.length()).replace("*", ".*"));
+                final java.util.regex.Matcher matcher = regex.matcher(currValue);
+                if (!matcher.find()) {
+                    return false;
+                }
+            } else if (!currValue.equals(value)) {
                 return false;
             }
         }
