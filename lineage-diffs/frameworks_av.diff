+        }
+        if (findBlobDuration(minDurations, width, height) >= 0) continue;
+
+        double scale = static_cast<double>(area) / activeArea;
+        int64_t minDuration = static_cast<int64_t>(refMin * scale);
+        if (minDuration <= kHighResolutionMinFrameDurationNs) {
+            minDuration = kHighResolutionMinFrameDurationNs + 1;
+        }
+        configs.insert(configs.end(), {format, width, height, direction});
+        minDurations.insert(minDurations.end(), {format, width, height, minDuration});
+        stallDurations.insert(stallDurations.end(),
+                {format, width, height, static_cast<int64_t>(refStall * scale)});
+        ALOGI("%s: exposing %dx%d jpeg from samsung picture configurations", __FUNCTION__,
+                width, height);
+        added = true;
+    }
+    if (!added) return;
+
+    info->update(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS, configs.data(), configs.size());
+    info->update(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS, minDurations.data(),
+            minDurations.size());
+    info->update(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS, stallDurations.data(),
+            stallDurations.size());
+
+    // BURST_CAPTURE keeps sub-20fps sizes out of getOutputSizes(); apps opt in via high res.
+    camera_metadata_ro_entry capsEntry = constInfo.find(ANDROID_REQUEST_AVAILABLE_CAPABILITIES);
+    std::vector<uint8_t> caps(capsEntry.data.u8, capsEntry.data.u8 + capsEntry.count);
+    if (std::find(caps.begin(), caps.end(),
+            ANDROID_REQUEST_AVAILABLE_CAPABILITIES_BURST_CAPTURE) == caps.end()) {
+        caps.push_back(ANDROID_REQUEST_AVAILABLE_CAPABILITIES_BURST_CAPTURE);
+        info->update(ANDROID_REQUEST_AVAILABLE_CAPABILITIES, caps.data(), caps.size());
+    }
+}
+
+void setSamsungRemosaicCameraClient(const CameraMetadata& deviceInfo, int64_t maxOutputArea,
+        CameraMetadata& sessionParams) {
+    camera_metadata_ro_entry activeArray = deviceInfo.find(ANDROID_SENSOR_INFO_ACTIVE_ARRAY_SIZE);
+    if (activeArray.count != 4 ||
+            maxOutputArea <= static_cast<int64_t>(activeArray.data.i32[2]) *
+                    activeArray.data.i32[3]) {
+        return;
+    }
+    uint32_t clientTag;
+    if (!getVendorTagByName(deviceInfo, "samsung.android.control.cameraClient", &clientTag)) {
+        return;
+    }
+    int32_t client = property_get_int32("debug.phh.samsung.remosaic_client", 1);
+    status_t res = sessionParams.update(clientTag, &client, 1);
+    ALOGI("%s: output larger than the active array, samsung cameraClient %d: %s (%d)",
+            __FUNCTION__, client, strerror(-res), res);
+}
+
+static int32_t getSamsungHighFpsVideoSize(const CameraMetadata& info, int32_t* width,
+        int32_t* height) {
+    uint32_t videoTag;
+    if (!getVendorTagByName(info, "samsung.android.scaler.availableVideoConfigurations",
+            &videoTag)) {
+        return 0;
+    }
+    camera_metadata_ro_entry video = info.find(videoTag);
+    int32_t bestFps = 0;
+    for (size_t i = 0; i + 5 < video.count; i += 6) {
+        int32_t fps = video.data.i32[i + 3];
+        int64_t area = static_cast<int64_t>(video.data.i32[i]) * video.data.i32[i + 1];
+        if (fps <= 30 || fps < bestFps ||
+                (fps == bestFps && area <= static_cast<int64_t>(*width) * *height)) {
+            continue;
+        }
+        bestFps = fps;
+        *width = video.data.i32[i];
+        *height = video.data.i32[i + 1];
+    }
+    return bestFps;
+}
+
+static bool fitsSamsungHighFpsVideoSize(int64_t width, int64_t height, int64_t maxWidth,
+        int64_t maxHeight) {
+    return width * maxHeight == height * maxWidth && width <= maxWidth;
+}
+
+void addSamsungHighFpsVideoRanges(CameraMetadata* info) {
+    int32_t videoWidth = 0;
+    int32_t videoHeight = 0;
+    int32_t fps = getSamsungHighFpsVideoSize(*info, &videoWidth, &videoHeight);
+    if (fps == 0) return;
+
+    const CameraMetadata& constInfo = *info;
+    camera_metadata_ro_entry rangesEntry =
+            constInfo.find(ANDROID_CONTROL_AE_AVAILABLE_TARGET_FPS_RANGES);
+    camera_metadata_ro_entry minEntry =
+            constInfo.find(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS);
+    if (rangesEntry.count == 0 || minEntry.count == 0) return;
+
+    std::vector<int32_t> ranges(rangesEntry.data.i32, rangesEntry.data.i32 + rangesEntry.count);
+    bool hasRange = false;
+    for (size_t i = 0; i + 1 < ranges.size(); i += 2) {
+        if (ranges[i] == fps && ranges[i + 1] == fps) hasRange = true;
+    }
+    if (!hasRange) ranges.insert(ranges.end(), {fps, fps});
+
+    int64_t frameDuration = 1000000000LL / fps;
+    std::vector<int64_t> minDurations(minEntry.data.i64, minEntry.data.i64 + minEntry.count);
+    for (size_t i = 0; i + 3 < minDurations.size(); i += 4) {
+        if (minDurations[i] != HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED &&
+                minDurations[i] != HAL_PIXEL_FORMAT_YCbCr_420_888) {
+            continue;
+        }
+        if (!fitsSamsungHighFpsVideoSize(minDurations[i + 1], minDurations[i + 2], videoWidth,
+                videoHeight)) {
+            continue;
+        }
+        minDurations[i + 3] = std::min(minDurations[i + 3], frameDuration);
+    }
+
+    info->update(ANDROID_CONTROL_AE_AVAILABLE_TARGET_FPS_RANGES, ranges.data(), ranges.size());
+    info->update(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS, minDurations.data(),
+            minDurations.size());
+    ALOGI("%s: exposing %d fps video up to %dx%d from samsung video configurations",
+            __FUNCTION__, fps, videoWidth, videoHeight);
+}
+
+bool hasSamsungHighFpsVideoAspect(const CameraMetadata& info, int32_t width, int32_t height) {
+    int32_t videoWidth = 0;
+    int32_t videoHeight = 0;
+    if (getSamsungHighFpsVideoSize(info, &videoWidth, &videoHeight) == 0) return true;
+    int64_t a = static_cast<int64_t>(width) * videoHeight;
+    int64_t b = static_cast<int64_t>(height) * videoWidth;
+    // 1% slack for 16:9 sizes that don't divide evenly, like 4080x2296
+    return (a > b ? a - b : b - a) * 100 <= a;
+}
+
+int32_t getSamsungHighFpsVideoFps(const CameraMetadata& info, int32_t width, int32_t height) {
+    int32_t videoWidth = 0;
+    int32_t videoHeight = 0;
+    int32_t fps = getSamsungHighFpsVideoSize(info, &videoWidth, &videoHeight);
+    if (fps == 0 || !fitsSamsungHighFpsVideoSize(width, height, videoWidth, videoHeight)) {
+        return 0;
+    }
+    return fps;
+}
